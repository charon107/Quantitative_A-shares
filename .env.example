# ===== 行情数据 =====
# KLINE_START_DATE=2013-01-01
# DASHBOARD_START_DATE=2025-01-01
# DUCKDB_PATH=market.duckdb
# DUCKDB_MEMORY_LIMIT=400MB
# DUCKDB_THREADS=2

# ===== Tushare =====
TUSHARE_TOKEN=REPLACE_WITH_YOUR_TUSHARE_TOKEN
TUSHARE_API_URL=
# TUSHARE_MAX_RETRIES=6
# TUSHARE_MAX_CALLS_PER_MIN=100

# ===== Redis 缓存 =====
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_ENABLED=true

# ===== SQL 网关 =====
# SQL_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# SQL_MAX_ROWS=2000000

# ===== 模拟盘 =====
# PAPER_DUCKDB_PATH=paper.duckdb

# ===== Auth / JWT（规范书 §8.1；真实密钥绝不落仓库）=====
AUTH_MODE=hybrid
JWT_SECRET=REPLACE_WITH_RANDOM_32B_MIN
# JWT_SECRET_PREVIOUS=
JWT_ISSUER=wechatnum-api
JWT_AUDIENCE=wechatnum-clients
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_LEEWAY=30
JWT_COOKIE_NAME=wn_refresh
# 生产 HTTPS 必须置 true（§10.2）；本地 http 开发保持 false
JWT_COOKIE_SECURE=false
REFRESH_ROTATE=true
PASSWORD_MIN_LEN=8
BCRYPT_ROUNDS=12
# DEFAULT_TENANT_ID=t_default
# LEGACY_ACCOUNT_ID_AUTH=true

# ===== 迁移脚本（scripts/migrate_add_tenant.py）=====
# MIGRATE_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_INITIAL_PASSWORD

